# This file controls what files are sent to Google Cloud Build.
# It overrides .gitignore. Keep only what's needed for the build context.

# VCS
.git/
.gitignore
.gcloudignore

# OS/IDE caches
**/.DS_Store
**/__pycache__/
**/.ipynb_checkpoints/
.idea/
.vscode/

# Large outputs not needed for the image
figures_output/
results/
reports/
logs/
archive/
zenodo_package/
docs/
scripts/
figures/

